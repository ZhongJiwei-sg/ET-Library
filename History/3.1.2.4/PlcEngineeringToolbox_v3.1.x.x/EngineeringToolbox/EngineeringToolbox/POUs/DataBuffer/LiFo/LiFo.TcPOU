    <Method Name="isEnqueued" Id="{b81e883f-de8d-48a1-a1fc-c54a9187ba66}">
      <Declaration><![CDATA[//Check wheter a value already exist
METHOD PUBLIC isEnqueued : uDINT //data exist in Fifo if reurn value <> 0, returns index of entry in buffer 
VAR_INPUT
	pData													: 	POINTER TO BYTE := 0;
	SizeOfData												: 	UDINT := 0;
	pMemory													: 	POINTER TO BYTE := 0;
	SizeOfMemory											: 	UDINT := 0;
END_VAR	
VAR
	i 														: 	DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsEnqueued := SUPER^._IsEnqueued(pData,SizeOfEntry,pMemory,SizeOfMemory);]]></ST>
      </Implementation>
    </Method>
